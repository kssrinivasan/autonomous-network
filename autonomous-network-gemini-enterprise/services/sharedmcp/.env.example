# =============================================================================
# Shared MCP Server Environment Variables
# =============================================================================
# This file documents the environment variables required by the sharedmcp server.
# Most values are sourced from config.sh at the repository root.
#
# SETUP:
# 1. Source the main config: source ../../config.sh
# 2. Copy this file: cp .env.example .env
# 3. Customize .env with any local overrides (optional)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# HTTP server port for the MCP tool server
PORT=8080

# -----------------------------------------------------------------------------
# GCP Configuration (from config.sh)
# -----------------------------------------------------------------------------

# GCP project ID - REQUIRED
# Source from config.sh: GOOGLE_PROJECT
GOOGLE_PROJECT=your-gcp-project-id

# GCP project number - REQUIRED for MCP auth (compute SA allowlist)
# Source from config.sh: GOOGLE_PROJECT_NUMBER
GOOGLE_PROJECT_NUMBER=your-project-number

# MCP inbound auth audience — set to the Cloud Run URL of this service to enable OIDC token validation.
# Leave unset for local development (disables auth).
MCP_AUDIENCE=https://your-sharedmcp-cloud-run-url

# GCP service account credentials file path (optional)
# When running in Cloud Run, this is set automatically via workload identity
# For local development, point to your service account key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/networkagent.json

# -----------------------------------------------------------------------------
# Gitea Configuration (from config.sh)
# -----------------------------------------------------------------------------

# Gitea authentication credentials - REQUIRED for git operations
# These must match the credentials in config.sh
# Source from config.sh: WEBAPPS_LOGIN, WEBAPPS_PWD
WEBAPPS_LOGIN=networkagent
WEBAPPS_PWD=your-password-here

# Gitea URL - REQUIRED
# The base URL for the Gitea server
GITEA_URL=https://your-gitea-ip

