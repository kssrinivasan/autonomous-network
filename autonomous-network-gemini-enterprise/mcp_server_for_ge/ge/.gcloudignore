# What NOT to upload to Cloud Build. See: gcloud topic gcloudignore
#
# This file has to exist. Without it gcloud synthesizes one from .gitignore,
# and .gitignore excludes src/agent_library -- the vendored copy of lib/ that
# deploy.sh makes just before deploying, and that src/utils/git_helpers.py
# imports. The synthesized version drops it from the upload and the container
# fails at import time with ModuleNotFoundError.
.git
.gitignore
**/__pycache__/
variables.json
