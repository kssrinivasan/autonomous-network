# Transport Topology API - Environment Variables
# Copy this file to .env and fill in your values for local development

# Google Cloud Project Configuration
GOOGLE_PROJECT=your-project-id
GOOGLE_REGION=your-region

# Google Cloud Spanner Configuration
SPANNER_INSTANCE=networktopology-instance
GOOGLE_SPANNER_TRANSPORT_DATABASE=transporttopology-db

# Service Configuration
PORT=8080

# Google Cloud Authentication (for local development)
# Set this to the path of your service account key JSON file
# OR run: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Enable debug logging
# LOG_LEVEL=DEBUG
