# Transport Intent Server - Local Development Environment Variables
# Copy this file to .env and fill in your values
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# Orchestrator URL (required for intent creation)
ORCHESTRATOR_URL=http://localhost:8081

# Google Cloud Spanner Configuration
SPANNER_INSTANCE=networktopology-instance
GOOGLE_SPANNER_OPS_DATABASE=agentops-db

# Service Configuration
PORT=8080

# Google Cloud Authentication (for local development)
# Set this to the path of your service account key JSON file
# OR run: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Enable debug logging
# LOG_LEVEL=DEBUG

# Debug mode: disables GCP authentication on outbound A2A calls (for local dev)
# DEBUG=true
