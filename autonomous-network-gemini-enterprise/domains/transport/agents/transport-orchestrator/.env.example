# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Enable DevLoggerPlugin output for local debugging (true/false)
DEBUG=false

GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

GOOGLE_APPLICATION_CREDENTIALS=yourdir/networkagent.json

SHARED_MCP_URL=http://youruri:8080
MCP_AUTH_ENABLED=true

# Public base URL advertised in the A2A agent card (must match where the agent is actually reachable)
APP_URL=http://yoururl:8081
