info:
  version: 1.0.9
  description: AMF initial local configuration

configuration:
  amfName: AMF
  ngapIpList:
    - {{ nf_ip }}
  ngapPort: 38412
  sbi:
    scheme: http
    registerIPv4: {{ nf_ip }}
    bindingIPv4: {{ nf_ip }}
    port: 8000
    tls:
      pem: cert/amf.pem
      key: cert/amf.key
  serviceNameList:
    - namf-comm
    - namf-evts
    - namf-mt
    - namf-loc
    - namf-oam
  servedGuamiList:
{% for plmn in plmn_list %}
    - plmnId:
        mcc: {{ plmn.mcc }}
        mnc: {{ plmn.mnc }}
      amfId: cafe00
{% endfor %}
  supportTaiList:
{% for plmn in plmn_list %}
    - plmnId:
        mcc: {{ plmn.mcc }}
        mnc: {{ plmn.mnc }}
      tac: {{ tac_hex }}
{% endfor %}
  plmnSupportList:
{% for plmn in plmn_list %}
    - plmnId:
        mcc: {{ plmn.mcc }}
        mnc: {{ plmn.mnc }}
      snssaiList:
{% for nssai in snssai_infos %}
        - sst: {{ nssai.sNssai.sst }}
{% if nssai.sNssai.sd %}
          sd: {{ nssai.sNssai.sd }}
{% endif %}
{% endfor %}
{% endfor %}
  supportDnnList:
{% for nssai in snssai_infos %}
{% for dnn_info in nssai.dnnInfos %}
    - {{ dnn_info.dnn }}
{% endfor %}
{% endfor %}
  nrfUri: {{ nrf_uri }}
  security:
    integrityOrder:
      - NIA2
    cipheringOrder:
      - NEA0
  networkName:
    full: free5GC
    short: free
  ngapIE:
    mobilityRestrictionList:
      enable: true
    maskedIMEISV:
      enable: true
    redirectionVoiceFallback:
      enable: false
  nasIE:
    networkFeatureSupport5GS:
      enable: true
      length: 1
      imsVoPS: 0 
      emc: 0
      emf: 0
      iwkN26: 0
      mpsi: 0
      emcN3: 0
      mcsi: 0
  t3502Value: 720
  t3512Value: 3600
  non3gppDeregTimerValue: 3240
  t3513:
    enable: true
    expireTime: 6s
    maxRetryTimes: 4
  t3522:
    enable: true
    expireTime: 6s
    maxRetryTimes: 4
  t3550:
    enable: true
    expireTime: 6s
    maxRetryTimes: 4
  t3560:
    enable: true
    expireTime: 6s
    maxRetryTimes: 4
  t3555:
    enable: true
    expireTime: 6s
    maxRetryTimes: 4
  t3565:
    enable: true
    expireTime: 6s
    maxRetryTimes: 4
  t3570:
    enable: true
    expireTime: 6s
    maxRetryTimes: 4
  locality: area1
  sctp:
    numOstreams: 3
    maxInstreams: 5
    maxAttempts: 2
    maxInitTimeout: 2
  defaultUECtxReq: false
{% if metrics_enabled %}
  metrics:
    enable: true
    scheme: {{ metrics_scheme }}
    bindingIPv4: 0.0.0.0
    port: {{ metrics_port }}
    namespace: {{ metrics_namespace }}
{% if metrics_scheme == 'https' %}
    tls:
      pem: cert/amf.pem
      key: cert/amf.key
{% endif %}
{% endif %}
logger:
  enable: true
  level: info
  reportCaller: false
