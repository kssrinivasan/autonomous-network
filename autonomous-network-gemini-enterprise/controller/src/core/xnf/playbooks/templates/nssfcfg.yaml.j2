info:
  version: 1.0.2
  description: NSSF initial local configuration

configuration:
  nssfName: NSSF
  sbi:
    scheme: http
    registerIPv4: {{ nf_ip }}
    bindingIPv4: {{ nf_ip }}
    port: 8000
    tls:
      pem: cert/nssf.pem
      key: cert/nssf.key
  serviceNameList:
    - nnssf-nsselection
    - nnssf-nssaiavailability
  nrfUri: {{ nrf_uri }}
  supportedPlmnList:
    - mcc: 208
      mnc: 93
  supportedNssaiInPlmnList:
    - plmnId:
        mcc: 208
        mnc: 93
      supportedSnssaiList:
        - sst: 1
          sd: 010203
        - sst: 1
          sd: 112233
        - sst: 1
          sd: 000003
        - sst: 2
          sd: 000001
        - sst: 2
          sd: 000002
  nsiList:
    - snssai:
        sst: 1
      nsiInformationList:
        - nrfId: {{ nrf_uri }}/nnrf-nfm/v1/nf-instances
          nsiId: 10
    - snssai:
        sst: 1
        sd: 000001
      nsiInformationList:
        - nrfId: {{ nrf_uri }}/nnrf-nfm/v1/nf-instances
          nsiId: 11
    - snssai:
        sst: 1
        sd: 010203
      nsiInformationList:
        - nrfId: {{ nrf_uri }}/nnrf-nfm/v1/nf-instances
          nsiId: 12
    - snssai:
        sst: 1
        sd: 112233
      nsiInformationList:
        - nrfId: {{ nrf_uri }}/nnrf-nfm/v1/nf-instances
          nsiId: 13
    - snssai:
        sst: 2
        sd: 000001
      nsiInformationList:
        - nrfId: {{ nrf_uri }}/nnrf-nfm/v1/nf-instances
          nsiId: 14
    - snssai:
        sst: 2
        sd: 000002
      nsiInformationList:
        - nrfId: {{ nrf_uri }}/nnrf-nfm/v1/nf-instances
          nsiId: 15
  amfSetList:
    - amfSetId: 1
      amfList:
      nrfAmfSet: {{ nrf_uri }}
      supportedNssaiAvailabilityData:
        - tai:
            plmnId:
              mcc: 208
              mnc: 93
            tac: 1
          supportedSnssaiList:
            - sst: 1
              sd: 010203
            - sst: 1
              sd: 112233
            - sst: 2
              sd: 000001
  taList:
    - tai:
        plmnId:
          mcc: 208
          mnc: 93
        tac: 1
      accessType: 3GPP_ACCESS
      supportedSnssaiList:
        - sst: 1
          sd: 010203
        - sst: 1
          sd: 112233
        - sst: 2
          sd: 000001
{% if metrics_enabled %}
  metrics:
    enable: true
    scheme: {{ metrics_scheme }}
    bindingIPv4: 0.0.0.0
    port: {{ metrics_port }}
    namespace: {{ metrics_namespace }}
{% if metrics_scheme == 'https' %}
    tls:
      pem: cert/nssf.pem
      key: cert/nssf.key
{% endif %}
{% endif %}
logger:
  enable: true
  level: info
  reportCaller: false
