# Vendored at deploy time from lib/src/agent_library, because lib/ is outside
# these services' --source build context. Never edit or commit these copies;
# edit lib/ and redeploy. Each service has a .gcloudignore so that ignoring
# them here does not also drop them from the Cloud Build upload.
/mcp_server_for_ge/ge/src/agent_library/
/mcp_server_for_ge/re/src/agent_library/

# Same vendoring, done by agents-in-agent-runtime/deploy_agents.py, which
# copytrees lib/src/agent_library into <agent>/app/ and rmtrees it in a finally.
# A `git add -A` while a deploy is in flight would otherwise commit it.
#
# Safe to ignore here, and ONLY here: agents-cli packages the upload itself
# (google/agents/cli/deploy/agent_runtime.py, _packaged_files(Path.cwd())) and
# _ignore_lines reads <agent>/.gcloudignore else <agent>/.gitignore -- never this
# file. Do NOT copy these lines into a per-agent .gitignore; that WOULD drop the
# library from the deploy package and the runtime fails at import time.
/agents-in-agent-runtime/*/app/agent_library/

# Written by each service's install.sh with the URL of the deployment it just
# made, and removed again by uninstall.sh. Nothing reads it back -- it exists
# only so the operator can find the URL after the fact -- so it is per-clone
# state, not source.
/domains/transport/services/*/.api_url
